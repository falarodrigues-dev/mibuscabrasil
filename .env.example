# Banco de dados Postgres (Supabase ou Neon). Ex.:
# Supabase: postgresql://postgres:[SENHA]@db.[PROJETO].supabase.co:5432/postgres
# Neon:     postgresql://[USUARIO]:[SENHA]@[HOST]/[DB]?sslmode=require
DATABASE_URL="postgresql://usuario:senha@host:5432/mibusca?schema=public"

# URL pública do site (usada em metadata, Open Graph, sitemap e robots.txt)
NEXT_PUBLIC_SITE_URL="https://mibusca.com.br"

# Valor inicial (bootstrap) do número de WhatsApp, usado apenas se a tabela
# "settings" ainda estiver vazia (ex.: antes do primeiro seed). Depois disso,
# o valor real e editável fica no banco (tabela settings), nunca no código.
WHATSAPP_NUMBER_DEFAULT="5571993827236"

# Meta Pixel e GA4 — opcionais. Se vazios, os scripts não são carregados.
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GA4_ID=""

# --- Fase 2 (painel administrativo) ---
# Usados para criar o primeiro usuário admin via seed. Troque a senha no
# primeiro acesso ao painel.
ADMIN_EMAIL="admin@mibusca.com.br"
ADMIN_PASSWORD="troque-esta-senha"

# Segredo usado para assinar o cookie de sessão do /admin.
ADMIN_SESSION_SECRET="gere-uma-string-aleatoria-longa-aqui"
